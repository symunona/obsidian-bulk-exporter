# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json
# Hot Reload marker, dev machine only.
.hotreload

# Exclude macOS Finder (System Explorer) View States
.DS_Store

.obsidian
# ...except the dev vault's config, so the plugin set is shared.
!test-vault/.obsidian
test-vault/.obsidian/workspace*.json
test-vault/.obsidian/plugins/bulk-exporter
test-vault/.obsidian/plugins/dataview
test-vault/.obsidian/plugins/hot-reload
